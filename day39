QQUES77:Check if the elements on the diagonal of a matrix are distinct.
  CODE:
  #include <stdio.h>

int main() {
    int n, a[100][100];
    int distinct = 1;

    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            if (a[i][i] == a[j][j]) {
                distinct = 0;
                break;
            }
        }
    }

    if (distinct)
        printf("Distinct");
    else
        printf("Not Distinct");

    return 0;
}
QUES78:Find the sum of main diagonal elements for a square matrix.
  CODE:
  #include <stdio.h>

int main() {
    int n, a[100][100];
    int sum = 0;

    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    for (int i = 0; i < n; i++) {
        sum = sum + a[i][i];
    }

    printf("%d", sum);

    return 0;
}
