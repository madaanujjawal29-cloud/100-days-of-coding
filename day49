QUES97:Print the initials of a name.
  CODE:
#include <stdio.h>

int main() {
    char name[100];
    int i;

    fgets(name, 100, stdin);

    if (name[0] != ' ')
        printf("%c", name[0]);

    for (i = 1; name[i] != '\0'; i++) {
        if (name[i - 1] == ' ' && name[i] != ' ' && name[i] != '\n') {
            printf("%c", name[i]);
        }
    }

    return 0;
}

QUES98:Print initials of a name with the surname displayed in full.
  CODE:
#include <stdio.h>

int main() {
    char name[100];
    int i, last = 0;

    fgets(name, 100, stdin);

    for (i = 0; name[i] != '\0'; i++) {
        if (name[i] == ' ' && name[i + 1] != ' ')
            last = i + 1;
    }

    if (last == 0) {
        printf("%s", name);
    } else {
        printf("%c. ", name[0]);

        for (i = 1; i < last; i++) {
            if (name[i - 1] == ' ' && name[i] != ' ')
                printf("%c. ", name[i]);
        }

        for (i = last; name[i] != '\0' && name[i] != '\n'; i++)
            printf("%c", name[i]);
    }

    return 0;
}
