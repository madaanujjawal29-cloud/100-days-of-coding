QUES35: Write a program to print all factors of a given number.
  CODE:
#include <stdio.h>

int main() {
    int n;

    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        if (n % i == 0) {
            printf("%d ", i);
        }
    }

    return 0;
}

QUES36:Write a program to find the HCF (GCD) of two numbers.
  CODE:
#include <stdio.h>

int main() {
    int a, b;

    scanf("%d %d", &a, &b);

    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }

    printf("%d", a);

    return 0;
}
