QUES27: Write a program to print the sum of the first n odd numbers.
CODE:
#include <stdio.h>

int main() {
    int n, sum = 0;

    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        sum += (2 * i - 1);
    }

    printf("%d", sum);

    return 0;
}

QUES28:Write a program to print the product of even numbers from 1 to n.
CODE:
#include <stdio.h>

int main() {
    int n;
    long long product = 1;

    scanf("%d", &n);

    for (int i = 2; i <= n; i += 2) {
        product *= i;
    }

    printf("%lld", product);

    return 0;
}
