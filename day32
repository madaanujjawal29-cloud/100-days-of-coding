  QUES63:Merge two arrays.
    CODE:
#include <stdio.h>

int main() {
    int n, m, a[100], b[100], c[200];
    int i;

    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    scanf("%d", &m);

    for (i = 0; i < m; i++) {
        scanf("%d", &b[i]);
    }

    for (i = 0; i < n; i++) {
        c[i] = a[i];
    }

    for (i = 0; i < m; i++) {
        c[n + i] = b[i];
    }

    for (i = 0; i < n + m; i++) {
        printf("%d ", c[i]);
    }

    return 0;
}

QUES64:Find the digit that occurs the most times in an integer number.
  CODE:
  #include <stdio.h>

int main() {
    long long n;
    int count[10] = {0};
    int digit, maxDigit = 0, maxCount = 0;

    scanf("%lld", &n);

    if (n < 0)
        n = -n;

    if (n == 0) {
        printf("0");
        return 0;
    }

    while (n > 0) {
        digit = n % 10;
        count[digit]++;
        n = n / 10;
    }

    for (int i = 0; i <= 9; i++) {
        if (count[i] > maxCount) {
            maxCount = count[i];
            maxDigit = i;
        }
    }

    printf("%d", maxDigit);

    return 0;
}
