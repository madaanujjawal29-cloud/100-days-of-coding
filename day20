QUES39:Write a program to find the product of odd digits of a number.
  CODE:
#include <stdio.h>

int main() {
    int n, digit;
    long long product = 1;

    scanf("%d", &n);

    if (n < 0)
        n = -n;

    while (n > 0) {
        digit = n % 10;
        if (digit % 2 != 0)
            product *= digit;
        n /= 10;
    }

    printf("%lld", product);

    return 0;
}

QUES40:Write a program to find the 1’s complement of a binary number and print it.
  CODE:
#include <stdio.h>

int main() {
    char binary[100];

    scanf("%s", binary);

    for (int i = 0; binary[i] != '\0'; i++) {
        if (binary[i] == '0')
            binary[i] = '1';
        else if (binary[i] == '1')
            binary[i] = '0';
    }

    printf("%s", binary);

    return 0;
}
