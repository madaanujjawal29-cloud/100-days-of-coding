QUES65:Search in a sorted array using binary search
  CODE:
  #include <stdio.h>

int main() {
    int n, arr[100], key;
    int low, high, mid, found = -1;

    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    scanf("%d", &key);

    low = 0;
    high = n - 1;

    while (low <= high) {
        mid = (low + high) / 2;

        if (arr[mid] == key) {
            found = mid;
            break;
        }
        else if (arr[mid] < key) {
            low = mid + 1;
        }
        else {
            high = mid - 1;
        }
    }

    if (found != -1)
        printf("%d", found);
    else
        printf("-1");

    return 0;
}

QUES66:Insert an element in a sorted array at the appropriate position.
  CODE:
  #include <stdio.h>

int main() {
    int n, arr[100], x, i, pos;

    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    scanf("%d", &x);

    pos = n;

    for (i = 0; i < n; i++) {
        if (x < arr[i]) {
            pos = i;
            break;
        }
    }

    for (i = n; i > pos; i--) {
        arr[i] = arr[i - 1];
    }

    arr[pos] = x;
    n++;

    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}
