QUES37:Write a program to find the LCM of two numbers.
  CODE:#include <stdio.h>

int main() {
    int a, b, i, gcd, lcm;

    scanf("%d %d", &a, &b);

    // Find GCD
    for (i = 1; i <= a && i <= b; i++) {
        if (a % i == 0 && b % i == 0) {
            gcd = i;
        }
    }

    // Find LCM
    lcm = (a * b) / gcd;

    printf("%d", lcm);

    return 0;
}

QUES38:Write a program to find the sum of digits of a number.
CODE:
#include <stdio.h>

int main() {
    int n, digit, sum = 0;

    scanf("%d", &n);

    while (n > 0) {
        digit = n % 10;
        sum += digit;
        n = n / 10;
    }

    printf("%d", sum);

    return 0;
}
