QUES95:Check if one string is a rotation of another.
  CODE:
  #include <stdio.h>

int main() {
    char str1[100], str2[100];
    int len1 = 0, len2 = 0;
    int i, j, match;

    scanf("%s", str1);
    scanf("%s", str2);

    while (str1[len1] != '\0')
        len1++;

    while (str2[len2] != '\0')
        len2++;

    if (len1 != len2) {
        printf("Not Rotation");
        return 0;
    }

    for (i = 0; i < len1; i++) {
        match = 1;

        for (j = 0; j < len1; j++) {
            if (str1[(i + j) % len1] != str2[j]) {
                match = 0;
                break;
            }
        }

        if (match) {
            printf("Rotation");
            return 0;
        }
    }

    printf("Not Rotation");

    return 0;
}

QUES96:Reverse each word in a sentence without changing the word order.
  CODE:
  #include <stdio.h>

int main() {
    char str[200];
    int i = 0, start, end;

    fgets(str, 200, stdin);

    while (str[i] != '\0') {

        if (str[i] == ' ') {
            printf(" ");
            i++;
        } else {
            start = i;

            while (str[i] != ' ' && str[i] != '\0' && str[i] != '\n') {
                i++;
            }

            end = i - 1;

            while (end >= start) {
                printf("%c", str[end]);
                end--;
            }

            if (str[i] == '\n')
                break;
        }
    }

    return 0;
}
