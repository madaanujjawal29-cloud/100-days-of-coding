QUES25: Write a program to implement a basic calculator using switch-case for +, -, *, /, %.
CODE:
#include <stdio.h>

int main() {
    int a, b;
    char op;

    scanf("%d %d %c", &a, &b, &op);

    switch (op) {
        case '+':
            printf("%d", a + b);
            break;

        case '-':
            printf("%d", a - b);
            break;

        case '*':
            printf("%d", a * b);
            break;

        case '/':
            printf("%d", a / b);
            break;

        case '%':
            printf("%d", a % b);
            break;

        default:
            printf("Invalid operator");
    }

    return 0;
}

QUES26: Write a program to print numbers from 1 to n.
CODE:
#include <stdio.h>

int main() {
    int n;

    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        printf("%d", i);

        if (i < n) {
            printf(" ");
        }
    }

    return 0;
}
