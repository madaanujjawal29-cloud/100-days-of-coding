QUES51:Write a program to print the following pattern:
    5
   45
  345
 2345
12345
      CODE:
#include <stdio.h>

int main() {
    int i, j;

    for (i = 5; i >= 1; i--) {

        for (j = 1; j < i; j++) {
            printf(" ");
        }

        for (j = i; j <= 5; j++) {
            printf("%d", j);
        }

        printf("\n");
    }

    return 0;
}

QUES52:Write a program to print the following pattern:

*

*
*
*

*
*
*
*
*

*
*
*

*

CODE:
#include <stdio.h>

int main() {
    int i, j;

    for (i = 1; i <= 5; i++) {

        if (i <= 3) {
            for (j = 1; j <= 2 * i - 1; j++) {
                printf("*\n");
            }
        } else {
            for (j = 1; j <= 2 * (6 - i) - 1; j++) {
                printf("*\n");
            }
        }

        if (i != 5) {
            printf("\n");
        }
    }

    return 0;
}
