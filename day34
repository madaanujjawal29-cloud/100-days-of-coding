QUES67:Insert an element in an array at a given position.
  CODE:
  #include <stdio.h>

int main() {
    int a[100], n, element, position, i;

    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    scanf("%d", &element);
    scanf("%d", &position);

    for (i = n; i >= position; i--) {
        a[i] = a[i - 1];
    }

    a[position - 1] = element;
    n++;

    for (i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }

    return 0;
}

QUES68:Delete an element from an array.
  CODE:
#include <stdio.h>

int main() {
    int a[100], n, position, i;

    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    scanf("%d", &position);

    for (i = position - 1; i < n - 1; i++) {
        a[i] = a[i + 1];
    }

    n--;

    for (i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }

    return 0;
}
