QUES91:Remove all vowels from a string.
  CODE:
#include <stdio.h>

int main() {
    char str[100];
    int i;

    fgets(str, sizeof(str), stdin);

    for (i = 0; str[i] != '\0'; i++) {
        if (str[i] != 'a' && str[i] != 'e' &&
            str[i] != 'i' && str[i] != 'o' &&
            str[i] != 'u' && str[i] != 'A' &&
            str[i] != 'E' && str[i] != 'I' &&
            str[i] != 'O' && str[i] != 'U') {
            
            printf("%c", str[i]);
        }
    }

    return 0;
}

QUES92:Find the first repeating lowercase alphabet in a string.
  CODE:
  #include <stdio.h>

int main() {
    char str[100];
    int count[26] = {0};
    int i;

    fgets(str, sizeof(str), stdin);

    for (i = 0; str[i] != '\0'; i++) {
        if (str[i] >= 'a' && str[i] <= 'z') {
            count[str[i] - 'a']++;

            if (count[str[i] - 'a'] == 2) {
                printf("%c", str[i]);
                return 0;
            }
        }
    }

    printf("No repeating alphabet");

    return 0;
}
  
