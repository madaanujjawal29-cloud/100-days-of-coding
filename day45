QUES89:Count frequency of a given character in a string.
  CODE:
  #include <stdio.h>

int main() {
    char str[100], ch;
    int i, count = 0;

    fgets(str, sizeof(str), stdin);
    scanf("%c", &ch);

    for (i = 0; str[i] != '\0'; i++) {
        if (str[i] == ch) {
            count++;
        }
    }

    printf("%d", count);

    return 0;
}

QUES90:Toggle case of each character in a string.
  CODE:
  #include <stdio.h>

int main() {
    char str[100];
    int i;

    fgets(str, sizeof(str), stdin);

    for (i = 0; str[i] != '\0'; i++) {
        if (str[i] >= 'A' && str[i] <= 'Z') {
            str[i] = str[i] + 32;
        }
        else if (str[i] >= 'a' && str[i] <= 'z') {
            str[i] = str[i] - 32;
        }
    }

    printf("%s", str);

    return 0;
}
