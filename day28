QUES55:Write a program to print all the prime numbers from 1 to n.
  CODE:
#include <stdio.h>

int main() {
    int n, i, j, prime;

    scanf("%d", &n);

    for (i = 2; i <= n; i++) {
        prime = 1;

        for (j = 2; j < i; j++) {
            if (i % j == 0) {
                prime = 0;
                break;
            }
        }

        if (prime == 1) {
            printf("%d ", i);
        }
    }

    return 0;
}

QUES56:Read and print elements of a one-dimensional array
  CODE:
#include <stdio.h>

int main() {
    int n, i;
    int a[100];

    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    for (i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }

    return 0;
}
