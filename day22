QUES43: Write a program to check if a number is a strong number.
  CODE:
  #include <stdio.h>

int main() {
    int n, temp, digit, sum = 0, fact, i;

    scanf("%d", &n);

    temp = n;

    while (temp > 0) {
        digit = temp % 10;
        fact = 1;

        for (i = 1; i <= digit; i++) {
            fact = fact * i;
        }

        sum = sum + fact;
        temp = temp / 10;
    }

    if (sum == n)
        printf("Strong");
    else
        printf("Not Strong");

    return 0;
}
QUES44:Write a program to find the sum of the series: 1 + 3/4 + 5/6 + 7/8 + … up to n terms.
  CODE:
#include <stdio.h>

int main() {
    int n, i;
    float sum = 0.0;

    scanf("%d", &n);

    for (i = 1; i <= n; i++) {
        sum = sum + (float)(2 * i - 1) / (2 * i);
    }

    printf("%.2f", sum);

    return 0;
}
